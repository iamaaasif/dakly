# ═══════════════════════════════════════════════════════════════════════
#  Dakly settings. Run ./setup.sh once: it copies this file to .env and fills
#  in every secret marked (auto). Then fill in the rest and start:
#      docker compose up -d --build
#  Check everything at any time:  docker compose exec app npm run doctor
#  Anything left empty simply stays off (that channel runs in test mode).
# ═══════════════════════════════════════════════════════════════════════

# ─── 1. Required ──────────────────────────────────────────────────────
# Public address of Dakly. Point the domain's DNS (A record) at this server first;
# HTTPS certificates are then made automatically. For a local trial: http://localhost
APP_URL="https://app.dakly.com.bd"
# Back-office admins (comma-separated). Sign up with this email to get /admin.
ADMIN_EMAILS="asif@wpxpo.com"
# Shown on emails, invoices, the privacy policy and the suspended page
SUPPORT_EMAIL="support@dakly.com.bd"
# (auto) Random secrets. Never change ENCRYPTION_KEY or POSTGRES_PASSWORD after the first start.
AUTH_SECRET="replace-with-64-random-hex-characters"
ENCRYPTION_KEY="replace-with-64-random-hex-characters"
POSTGRES_PASSWORD="change-me"

# ─── 2. Email (password reset, receipts, approvals, ticket replies) ──
# Any SMTP service: Zoho Mail, Brevo, Amazon SES, Mailgun, Gmail (app password)...
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dakly <no-reply@dakly.com.bd>"

# ─── 3. OpenAI (AI messages, posts, replies, daily tips, voice input, AI call speech) ──
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"

# ─── 4. WhatsApp Cloud API (the shared Dakly number every shop uses by default) ──
# Meta Business app -> WhatsApp -> API setup. Use a permanent System User token.
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
# Approved Marketing template with body variables {{1}} = first name, {{2}} = message
WA_TEMPLATE_NAME="dakly_offer"
WA_TEMPLATE_LANG="bn"
# Webhook URL in Meta: https://APP_URL/api/webhooks/whatsapp  (subscribe to "messages")
# (auto) WA_VERIFY_TOKEN: enter the same value in Meta. WA_APP_SECRET: Meta App settings -> Basic -> App secret.
WA_VERIFY_TOKEN="replace-with-random"
WA_APP_SECRET=""

# ─── 5. SMS gateway for Bangladesh (BulkSMSBD-style: api_key / senderid / number / message) ──
SMS_API_URL="https://bulksmsbd.net/api/smsapi"
SMS_API_KEY=""
SMS_SENDER_ID=""
# Countries this gateway serves (comma-separated). Other countries send SMS through Twilio.
SMS_GATEWAY_COUNTRIES="BD"
# SMS campaigns end with an opt-out link. Set false only if your gateway adds its own.
SMS_OPTOUT_LINK="true"

# ─── 6. Twilio (AI voice calls; SMS outside Bangladesh) ───────────────
# Incoming-SMS webhook for STOP replies: https://APP_URL/api/webhooks/twilio-sms
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Optional separate number for SMS (defaults to TWILIO_FROM)
TWILIO_SMS_FROM=""

# ─── 7. Facebook Login (sellers connect their Page with one click) ────
# Permissions: pages_show_list, pages_manage_posts, pages_read_engagement
# Valid OAuth redirect URI: https://APP_URL/api/facebook/callback
FB_APP_ID=""
FB_APP_SECRET=""

# ─── 8. Payments in Bangladesh: SSLCommerz (bKash, Nagad, Rocket, cards) ──
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
# true = sandbox (test money). Set false with your live store to take real payments.
SSLCZ_SANDBOX="true"

# ─── 9. Payments elsewhere: Stripe Checkout (USD) ─────────────────────
# Webhook endpoint: https://APP_URL/api/billing/stripe  (event: checkout.session.completed)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── 10. Business ─────────────────────────────────────────────────────
# "manual" = new merchants wait for approval in /admin; "auto" = start right away
SIGNUP_APPROVAL="auto"
# Set to false to close public sign-up
ALLOW_SIGNUP="true"
# Shown on invoices
BUSINESS_NAME="Dakly"
BUSINESS_ADDRESS="Dhaka, Bangladesh"
BUSINESS_TAX_ID=""
# Plan prices per month. Empty = defaults (Starter 990 / Growth 2490 BDT; 12 / 29 USD)
PRICE_STARTER_BDT=""
PRICE_GROWTH_BDT=""
PRICE_STARTER_USD=""
PRICE_GROWTH_USD=""
# For MRR in /admin when some shops pay in USD
USD_TO_BDT="120"
# Cost estimates per unit in BDT (for /admin/usage)
COST_WA_BDT="1.2"
COST_SMS_BDT="0.35"
COST_VOICE_BDT="12"
COST_AI_BDT="0.4"

# ─── 11. Running ──────────────────────────────────────────────────────
# The scheduler runs inside the app every minute. Set false only if you call /api/cron yourself.
RUN_SCHEDULER="true"
# (auto) Needed only for /api/cron
CRON_SECRET="replace-with-random"
SHOPIFY_API_VERSION="2026-07"
# Database backups in ./backups
BACKUP_EVERY_HOURS="24"
BACKUP_KEEP_DAYS="14"

# ─── 12. Android app (Trusted Web Activity / App Links) ───────────────
# Served at /.well-known/assetlinks.json. Add the Play App Signing SHA-256 fingerprint (comma-separated).
ANDROID_PACKAGE="bd.com.dakly.app"
ANDROID_CERT_SHA256="14:06:C2:84:88:76:37:7F:45:D4:ED:E7:D3:FB:AD:65:13:FA:FF:D9:9D:87:19:0A:45:AF:C2:66:E2:27:2C:A1"
