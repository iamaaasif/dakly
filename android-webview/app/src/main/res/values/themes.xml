<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default, dark under values-night: the WebView reports prefers-color-scheme from this. -->
    <style name="Theme.Dakly.Base" parent="@android:style/Theme.Material.Light.NoActionBar"/>
    <style name="Theme.Dakly" parent="Theme.Dakly.Base">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorAccent">@color/dak</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>
</resources>
